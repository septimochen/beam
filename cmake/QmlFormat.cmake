cmake_minimum_required(VERSION 3.25)
find_program(formatter NAMES "${BEAM_QMLFORMAT}" qmlformat HINTS /usr/lib/qt6/bin)
if(NOT formatter)
    message(FATAL_ERROR "qmlformat is required for QML formatting; install Qt declarative development tools or set QMLFORMAT")
endif()
file(GLOB sources "${BEAM_SOURCE_DIR}/src/desktop/qt/qml/*.qml")
foreach(source IN LISTS sources)
    if(BEAM_WRITE)
        execute_process(COMMAND "${formatter}" -i "${source}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND "${formatter}" "${source}" OUTPUT_VARIABLE formatted COMMAND_ERROR_IS_FATAL ANY)
        file(READ "${source}" original)
        if(NOT original STREQUAL formatted)
            message(FATAL_ERROR "QML formatting differs: ${source}; run make qml-format")
        endif()
    endif()
endforeach()
