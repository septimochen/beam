cmake_minimum_required(VERSION 3.25)

find_program(tidy NAMES "${BEAM_CLANG_TIDY}")
if(NOT tidy)
    message(FATAL_ERROR "clang-tidy 23 is required; install LLVM and set CLANG_TIDY to its executable")
endif()
execute_process(COMMAND "${tidy}" --version RESULT_VARIABLE status OUTPUT_VARIABLE version ERROR_VARIABLE error)
if(NOT status STREQUAL "0" OR NOT version MATCHES "version 23\\.")
    message(FATAL_ERROR "Beam requires clang-tidy 23 (found: ${version}${error}); set CLANG_TIDY to its executable")
endif()

set(database "${BEAM_BUILD_DIR}/compile_commands.json")
if(NOT EXISTS "${database}")
    message(FATAL_ERROR "Missing ${database}; configure with a generator that exports compile_commands.json")
endif()
file(READ "${database}" commands)
string(JSON count LENGTH "${commands}")
set(sources)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON source GET "${commands}" ${index} file)
        string(JSON directory GET "${commands}" ${index} directory)
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${directory}")
        file(RELATIVE_PATH relative "${BEAM_SOURCE_DIR}" "${source}")
        if(relative MATCHES "^(src|tests)/.*\\.(cpp|mm)$")
            list(APPEND sources "${source}")
        endif()
    endforeach()
endif()
list(REMOVE_DUPLICATES sources)
if(NOT sources)
    message(FATAL_ERROR "No Beam translation units found in ${database}")
endif()

set(arguments "-p=${BEAM_BUILD_DIR}" "--config-file=${BEAM_SOURCE_DIR}/.clang-tidy")
if(BEAM_CLANG_TIDY_CHECKS)
    list(APPEND arguments "--checks=${BEAM_CLANG_TIDY_CHECKS}")
endif()
# Apple Clang locates the SDK implicitly; upstream clang-tidy may need it explicitly.
# Add defaults before compilation flags so an explicitly configured SDK wins.
if(CMAKE_HOST_APPLE)
    execute_process(COMMAND xcrun --sdk macosx --show-sdk-path
        RESULT_VARIABLE status OUTPUT_VARIABLE sdk ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot locate the macOS SDK: ${error}")
    endif()
    list(APPEND arguments "--extra-arg-before=-isysroot" "--extra-arg-before=${sdk}")
endif()

set(lint_failed FALSE)
foreach(source IN LISTS sources)
    file(RELATIVE_PATH relative "${BEAM_SOURCE_DIR}" "${source}")
    message(STATUS "Linting ${relative}")
    execute_process(COMMAND "${tidy}" ${arguments} "${source}" RESULT_VARIABLE status
        OUTPUT_VARIABLE tidy_output ERROR_VARIABLE tidy_error)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${tidy_output}${tidy_error}")
    if(NOT status STREQUAL "0")
        # Keep diagnostics accessible through the Checks API, including for
        # public jobs whose downloadable logs require a GitHub login.
        if(DEFINED ENV{GITHUB_ACTIONS})
            set(diagnostic "${tidy_output}${tidy_error}")
            string(SUBSTRING "${diagnostic}" 0 20000 diagnostic)
            string(REPLACE "%" "%25" diagnostic "${diagnostic}")
            string(REPLACE "\r" "%0D" diagnostic "${diagnostic}")
            string(REPLACE "\n" "%0A" diagnostic "${diagnostic}")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "::error file=${relative}::${diagnostic}")
        endif()
        set(lint_failed TRUE)
        message(STATUS "clang-tidy failed for ${relative}")
    endif()
endforeach()
if(lint_failed)
    message(FATAL_ERROR "clang-tidy failed; see the source diagnostics above")
endif()
