# Publish dependency archives only after a complete, checksum-verified download.
function(beam_download_verified url archive sha256)
    get_filename_component(directory "${archive}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    message(STATUS "Preparing dependency archive: ${archive}")
    file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 30)
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual)
        if(actual STREQUAL sha256)
            message(STATUS "Using verified archive: ${archive}")
            return()
        endif()
        message(STATUS "Replacing incomplete or invalid archive: ${archive}")
        file(REMOVE "${archive}")
    endif()

    string(RANDOM LENGTH 16 suffix)
    set(partial "${archive}.${suffix}.part")
    foreach(cached IN LISTS ARGN)
        if(EXISTS "${cached}" AND NOT IS_DIRECTORY "${cached}")
            file(SHA256 "${cached}" actual)
            if(actual STREQUAL sha256)
                message(STATUS "Reusing verified cached archive: ${cached}")
                file(COPY_FILE "${cached}" "${partial}")
                break()
            endif()
        endif()
    endforeach()

    if(NOT EXISTS "${partial}")
        message(STATUS "Downloading ${url} (timeout: 300s; inactivity: 30s)")
        file(DOWNLOAD "${url}" "${partial}" TLS_VERIFY ON SHOW_PROGRESS
            TIMEOUT 300 INACTIVITY_TIMEOUT 30 STATUS status)
        list(GET status 0 code)
        list(GET status 1 reason)
        if(NOT code EQUAL 0)
            file(REMOVE "${partial}")
            message(FATAL_ERROR "Dependency download failed (${code}): ${reason}. Retry the dependency setup command; completed builds are retained.")
        endif()
    endif()
    file(SHA256 "${partial}" actual)
    if(NOT actual STREQUAL sha256)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Dependency archive SHA-256 mismatch for ${url}; incomplete download removed. Retry the dependency setup command.")
    endif()
    file(RENAME "${partial}" "${archive}")
endfunction()
