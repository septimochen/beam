cmake_minimum_required(VERSION 3.25)
if(NOT EXISTS "${ANDROID_APK}")
    message(FATAL_ERROR "APK not found: ${ANDROID_APK}. Run make android first.")
endif()
if(NOT ADB)
    set(ADB adb)
endif()
find_program(adb_executable NAMES "${ADB}"
    HINTS "$ENV{ANDROID_HOME}/platform-tools" "$ENV{ANDROID_SDK_ROOT}/platform-tools"
    PATHS "${CMAKE_CURRENT_LIST_DIR}/../build/android-tools/sdk/platform-tools")
if(NOT adb_executable)
    message(FATAL_ERROR "ADB not found. Install Android SDK platform-tools and set ANDROID_HOME to the SDK directory, or run make android-install-apk ADB=/absolute/path/to/adb.")
endif()
execute_process(COMMAND "${adb_executable}" devices
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "adb devices failed: ${error}")
endif()
string(REPLACE "\r" "" output "${output}")
string(REPLACE "\n" ";" lines "${output}")
set(devices "")
foreach(line IN LISTS lines)
    if(line MATCHES "^([^ \t]+)[ \t]+device$")
        list(APPEND devices "${CMAKE_MATCH_1}")
    endif()
endforeach()
if(ANDROID_SERIAL STREQUAL "")
    list(LENGTH devices count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one authorized Android device; found ${count}.\n${output}\nConnect your phone, enable USB debugging, unlock it and approve this computer.\nFor multiple devices, set ANDROID_SERIAL from adb devices.")
    endif()
    list(GET devices 0 ANDROID_SERIAL)
elseif(NOT ANDROID_SERIAL IN_LIST devices)
    message(FATAL_ERROR "Android device ${ANDROID_SERIAL} is absent, offline or unauthorized.\n${output}\nUnlock your phone and approve USB debugging.")
endif()
message(STATUS "Installing ${ANDROID_APK} on ${ANDROID_SERIAL}")
execute_process(COMMAND "${adb_executable}" -s "${ANDROID_SERIAL}" install -r "${ANDROID_APK}"
    COMMAND_ERROR_IS_FATAL ANY)
