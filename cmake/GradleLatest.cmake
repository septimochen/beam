cmake_minimum_required(VERSION 3.25)

# Resolve only stable releases, and never publish partially validated properties.
function(beam_gradle_properties metadata output)
    foreach(field IN ITEMS version checksum current snapshot nightly broken)
        string(JSON ${field} ERROR_VARIABLE error GET "${metadata}" "${field}")
        if(error)
            message(FATAL_ERROR "Invalid Gradle release metadata: ${field}: ${error}")
        endif()
        string(JSON type TYPE "${metadata}" "${field}")
        if(field STREQUAL "version" OR field STREQUAL "checksum")
            set(expected_type STRING)
        else()
            set(expected_type BOOLEAN)
        endif()
        if(NOT type STREQUAL expected_type)
            message(FATAL_ERROR "Invalid Gradle release metadata type: ${field}")
        endif()
    endforeach()
    if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            OR NOT current OR snapshot OR nightly OR broken)
        message(FATAL_ERROR "Gradle metadata does not describe a current stable release")
    endif()
    string(LENGTH "${checksum}" checksum_length)
    if(NOT checksum_length EQUAL 64 OR NOT checksum MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid Gradle distribution SHA-256")
    endif()
    set(GRADLE_VERSION "${version}")
    set(GRADLE_SHA256 "${checksum}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../android/gradle/wrapper/gradle-wrapper.properties.in"
        "${output}.tmp" @ONLY)
    file(RENAME "${output}.tmp" "${output}")
    message(STATUS "Selected latest stable Gradle ${version} (distribution SHA-256 configured)")
endfunction()

function(beam_gradle_latest)
    set(directory "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../android/gradle/wrapper")
    # Serialize setup across concurrent Make/direct-wrapper invocations.
    file(LOCK "${directory}/latest.lock" GUARD FUNCTION TIMEOUT 180)
    set(metadata_file "${directory}/latest.json.tmp")
    foreach(attempt RANGE 1 4)
        file(DOWNLOAD "https://services.gradle.org/versions/current" "${metadata_file}"
            TLS_VERIFY ON TIMEOUT 30 INACTIVITY_TIMEOUT 15 STATUS status)
        list(GET status 0 code)
        list(GET status 1 reason)
        if(code EQUAL 0)
            file(READ "${metadata_file}" metadata)
            file(REMOVE "${metadata_file}")
            beam_gradle_properties("${metadata}" "${directory}/gradle-wrapper.properties")
            return()
        endif()
        file(REMOVE "${metadata_file}")
        message(STATUS "Gradle release lookup ${attempt}/4 failed: ${reason}")
        if(attempt LESS 4)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep "${attempt}")
        endif()
    endforeach()
    message(FATAL_ERROR "Cannot resolve latest stable Gradle: ${reason}. Retry the Android command.")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    beam_gradle_latest()
endif()
