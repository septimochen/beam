# Shared tool selection for Make, Gradle, and Android Studio. Builds only inspect
# installed packages; downloading newer tools requires the explicit setup action.
cmake_minimum_required(VERSION 3.25)
set(project_dir "${CMAKE_CURRENT_LIST_DIR}/..")
foreach(option ANDROID_HOME ANDROID_ABI ANDROID_NDK ANDROID_PLATFORM_VERSION ANDROID_BUILD_TOOLS_VERSION
        ANDROID_NDK_VERSION ANDROID_CMAKE_VERSION ANDROID_SETUP_DRY_RUN SDKMANAGER)
    if("${${option}}" STREQUAL "" AND DEFINED ENV{${option}})
        set(${option} "$ENV{${option}}")
    endif()
endforeach()
if(DEFINED ANDROID_ABI AND NOT ANDROID_ABI STREQUAL "arm64-v8a")
    message(FATAL_ERROR "Beam Android supports only arm64-v8a")
endif()
if(NOT ANDROID_HOME)
    set(ANDROID_HOME "$ENV{ANDROID_SDK_ROOT}")
endif()
if(NOT ANDROID_HOME AND EXISTS "${project_dir}/android/local.properties")
    file(STRINGS "${project_dir}/android/local.properties" sdk_line REGEX "^sdk\\.dir=")
    string(REGEX REPLACE "^sdk\\.dir=" "" ANDROID_HOME "${sdk_line}")
    string(REPLACE "\\:" ":" ANDROID_HOME "${ANDROID_HOME}")
    string(REPLACE "\\ " " " ANDROID_HOME "${ANDROID_HOME}")
    string(REPLACE "\\\\" "\\" ANDROID_HOME "${ANDROID_HOME}")
endif()
if(NOT ANDROID_HOME AND IS_DIRECTORY "${project_dir}/build/android-tools/sdk")
    set(ANDROID_HOME "${project_dir}/build/android-tools/sdk")
endif()
if(NOT IS_DIRECTORY "${ANDROID_HOME}")
    message(FATAL_ERROR "Set ANDROID_HOME to your Android SDK directory")
endif()
get_filename_component(ANDROID_HOME "${ANDROID_HOME}" ABSOLUTE)

function(read_property directory name output)
    set(value "")
    if(EXISTS "${directory}/source.properties")
        file(STRINGS "${directory}/source.properties" line REGEX "^${name}[ \t]*=")
        string(REGEX REPLACE "^[^=]*=[ \t]*" "" value "${line}")
        string(STRIP "${value}" value)
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(select_installed folder prefix override marker output)
    if(override)
        set(candidates "${override}")
    else()
        file(GLOB candidates RELATIVE "${ANDROID_HOME}/${folder}" "${ANDROID_HOME}/${folder}/${prefix}*")
        list(SORT candidates COMPARE NATURAL ORDER DESCENDING)
    endif()
    foreach(candidate IN LISTS candidates)
        string(REGEX REPLACE "^${prefix}" "" version "${candidate}")
        set(directory "${ANDROID_HOME}/${folder}/${prefix}${version}")
        if(NOT version MATCHES "^[0-9]+(\\.[0-9]+)*$" OR NOT EXISTS "${directory}/${marker}")
            continue()
        endif()
        read_property("${directory}" "Pkg.Revision" revision)
        if(NOT revision MATCHES "^[0-9]+(\\.[0-9]+)*$")
            continue()
        endif()
        if(folder STREQUAL "platforms")
            read_property("${directory}" "AndroidVersion.CodeName" codename)
            read_property("${directory}" "AndroidVersion.BetaVersion" beta)
            if((codename AND NOT codename STREQUAL "REL") OR beta)
                continue()
            endif()
        endif()
        set(${output} "${version}" PARENT_SCOPE)
        return()
    endforeach()
    message(FATAL_ERROR "No usable stable ${folder} package '${override}' in ${ANDROID_HOME}. Run make android-setup or change the version override.")
endfunction()

if(BEAM_ANDROID_ACTION STREQUAL "setup")
    if(NOT SDKMANAGER)
        unset(SDKMANAGER)
        find_program(SDKMANAGER sdkmanager HINTS "${ANDROID_HOME}/cmdline-tools/latest/bin" REQUIRED)
    endif()
    execute_process(COMMAND "${SDKMANAGER}" "--sdk_root=${ANDROID_HOME}" --list --channel=0
        OUTPUT_VARIABLE catalog COMMAND_ERROR_IS_FATAL ANY)
    # CMake uses semicolons as list separators; protect package paths while parsing.
    string(REPLACE ";" "@" catalog "${catalog}")
    string(REGEX MATCHALL "[^\r\n]+" lines "${catalog}")
    foreach(kind platforms build-tools ndk cmake)
        set(versions)
        foreach(line IN LISTS lines)
            string(STRIP "${line}" line)
            if(line MATCHES "^${kind}@([^ |]+)[ \t]*\\|[ \t]*([0-9.]+)[ \t]*\\|")
                set(version "${CMAKE_MATCH_1}")
                if(kind STREQUAL "platforms")
                    string(REGEX REPLACE "^android-" "" version "${version}")
                endif()
                if(version MATCHES "^[0-9]+(\\.[0-9]+)*$")
                    list(APPEND versions "${version}")
                endif()
            endif()
        endforeach()
        list(REMOVE_DUPLICATES versions)
        list(SORT versions COMPARE NATURAL ORDER DESCENDING)
        if(kind STREQUAL "platforms")
            set(requested "${ANDROID_PLATFORM_VERSION}")
            set(package_prefix "platforms;android-")
        elseif(kind STREQUAL "build-tools")
            set(requested "${ANDROID_BUILD_TOOLS_VERSION}")
            set(package_prefix "build-tools;")
        elseif(kind STREQUAL "ndk")
            set(requested "${ANDROID_NDK_VERSION}")
            set(package_prefix "ndk;")
        else()
            set(requested "${ANDROID_CMAKE_VERSION}")
            set(package_prefix "cmake;")
        endif()
        if(requested)
            if(NOT requested IN_LIST versions)
                message(FATAL_ERROR "${package_prefix}${requested} is not an available stable package")
            endif()
            set(selected "${requested}")
        elseif(versions)
            list(GET versions 0 selected)
        else()
            message(FATAL_ERROR "No stable ${kind} packages in sdkmanager output")
        endif()
        string(APPEND packages "${package_prefix}${selected}\n")
    endforeach()
    string(APPEND packages "platform-tools\n")
    message(STATUS "Android SDK packages:\n${packages}")
    if(NOT ANDROID_SETUP_DRY_RUN)
        file(MAKE_DIRECTORY "${project_dir}/build/android-tools")
        string(RANDOM LENGTH 12 suffix)
        set(package_file "${project_dir}/build/android-tools/packages-${suffix}.txt")
        file(WRITE "${package_file}" "${packages}")
        execute_process(COMMAND "${SDKMANAGER}" "--sdk_root=${ANDROID_HOME}" --channel=0
            "--package_file=${package_file}" COMMAND_ERROR_IS_FATAL ANY)
        file(REMOVE "${package_file}")
    endif()
    return()
endif()

select_installed(platforms android- "${ANDROID_PLATFORM_VERSION}" android.jar platform)
select_installed(build-tools "" "${ANDROID_BUILD_TOOLS_VERSION}" aapt2 build_tools)
select_installed(cmake "" "${ANDROID_CMAKE_VERSION}" bin/cmake cmake_version)
if(ANDROID_NDK)
    if(NOT EXISTS "${ANDROID_NDK}/build/cmake/android.toolchain.cmake")
        message(FATAL_ERROR "ANDROID_NDK must name an installed NDK directory")
    endif()
    get_filename_component(ANDROID_NDK "${ANDROID_NDK}" ABSOLUTE)
    read_property("${ANDROID_NDK}" "Pkg.Revision" ndk_version)
    if(ANDROID_NDK_VERSION AND NOT ANDROID_NDK_VERSION STREQUAL ndk_version)
        message(FATAL_ERROR "ANDROID_NDK and ANDROID_NDK_VERSION select different versions")
    endif()
else()
    select_installed(ndk "" "${ANDROID_NDK_VERSION}" build/cmake/android.toolchain.cmake ndk_version)
    set(ANDROID_NDK "${ANDROID_HOME}/ndk/${ndk_version}")
endif()
if(NOT ndk_version MATCHES "^[0-9]+(\\.[0-9]+)*$" OR ndk_version VERSION_LESS 28)
    message(FATAL_ERROR "Beam requires a stable NDK 28 or newer for C++23 support")
endif()
if(cmake_version VERSION_LESS 3.25 OR platform VERSION_LESS 37)
    message(FATAL_ERROR "Beam requires CMake 3.25+ and Android SDK platform 37+")
endif()
set(android_cmake "${ANDROID_HOME}/cmake/${cmake_version}/bin/cmake")
if(BEAM_ANDROID_ACTION STREQUAL "properties")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo
        "sdk=${ANDROID_HOME}\nplatform=${platform}\nbuildTools=${build_tools}\nndk=${ANDROID_NDK}\nndkVersion=${ndk_version}\ncmake=${cmake_version}")
else()
    message(STATUS "Android ARM64: SDK ${platform}, Build Tools ${build_tools}, NDK ${ndk_version}, CMake ${cmake_version}")
    message(STATUS "SDK: ${ANDROID_HOME}")
    if(NOT BEAM_ANDROID_DEPS)
        set(BEAM_ANDROID_DEPS "${project_dir}/build/android-deps")
    endif()
    if(BEAM_ANDROID_ACTION STREQUAL "deps")
        execute_process(COMMAND "${android_cmake}" "-DANDROID_NDK=${ANDROID_NDK}" -DANDROID_ABI=arm64-v8a
            "-DBEAM_ANDROID_DEPS=${BEAM_ANDROID_DEPS}" -P "${CMAKE_CURRENT_LIST_DIR}/BootstrapAndroid.cmake"
            COMMAND_ERROR_IS_FATAL ANY)
    elseif(BEAM_ANDROID_ACTION STREQUAL "test")
        execute_process(COMMAND "${android_cmake}" "-DBEAM_SOURCE_DIR=${project_dir}"
            "-DBEAM_ANDROID_DEPS=${BEAM_ANDROID_DEPS}" "-DANDROID_NDK=${ANDROID_NDK}"
            -P "${project_dir}/tests/android_dependencies.cmake" COMMAND_ERROR_IS_FATAL ANY)
    endif()
endif()
