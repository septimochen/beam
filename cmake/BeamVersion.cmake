cmake_minimum_required(VERSION 3.25)

set(beam_version_file "${CMAKE_CURRENT_LIST_DIR}/../version.properties")
file(STRINGS "${beam_version_file}" beam_version_line REGEX "^version=")
file(STRINGS "${beam_version_file}" beam_android_code_line REGEX "^androidVersionCode=")
if(NOT beam_version_line MATCHES "^version=((0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$")
    message(FATAL_ERROR "version.properties must define one version=MAJOR.MINOR.PATCH")
endif()
set(BEAM_RELEASE_VERSION "${CMAKE_MATCH_1}")
if(NOT beam_android_code_line MATCHES "^androidVersionCode=([1-9][0-9]*)$")
    message(FATAL_ERROR "version.properties must define one positive androidVersionCode")
endif()
set(BEAM_ANDROID_VERSION_CODE "${CMAKE_MATCH_1}")
if(BEAM_ANDROID_VERSION_CODE GREATER 2100000000)
    message(FATAL_ERROR "androidVersionCode exceeds the Android version code limit")
endif()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(DEFINED BEAM_RELEASE_TAG AND NOT BEAM_RELEASE_TAG STREQUAL "v${BEAM_RELEASE_VERSION}")
        message(FATAL_ERROR "Release tag '${BEAM_RELEASE_TAG}' must be v${BEAM_RELEASE_VERSION}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${BEAM_RELEASE_VERSION}")
endif()
