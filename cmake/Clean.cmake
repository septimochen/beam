cmake_minimum_required(VERSION 3.25)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." source)

# These are disposable output locations even after an interrupted configure.
set(known "${source}/build" "${source}/android/build"
    "${source}/android/app/build" "${source}/android/app/.cxx")
file(GLOB siblings LIST_DIRECTORIES TRUE "${source}/build-*")
foreach(path IN LISTS siblings)
    if(IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
        list(APPEND known "${path}")
    endif()
endforeach()
set(paths ${known})
foreach(option BUILD_DIR DESKTOP_BUILD_DIR INSTALL_BUILD_DIR)
    if(NOT DEFINED ${option} OR "${${option}}" STREQUAL "" OR "${${option}}" MATCHES "[;\r\n]")
        message(FATAL_ERROR "${option} must name a build directory without semicolons or newlines")
    endif()
    get_filename_component(path "${${option}}" ABSOLUTE BASE_DIR "${source}")
    list(APPEND paths "${path}")
endforeach()
list(REMOVE_DUPLICATES paths)

# Drop descendants before validation/removal, including paths below a build symlink.
set(roots)
foreach(path IN LISTS paths)
    if(NOT IS_ABSOLUTE "${path}")
        message(FATAL_ERROR "Invalid build path: ${path}")
    endif()
    set(nested FALSE)
    foreach(other IN LISTS paths)
        cmake_path(IS_PREFIX other "${path}" NORMALIZE inside)
        if(inside AND NOT path STREQUAL other)
            set(nested TRUE)
            break()
        endif()
    endforeach()
    if(NOT nested)
        list(APPEND roots "${path}")
    endif()
endforeach()

# Validate every root before deleting anything. Custom trees need Beam ownership.
foreach(path IN LISTS roots)
    cmake_path(IS_PREFIX path "${source}" NORMALIZE contains_source)
    if(contains_source)
        message(FATAL_ERROR "Refusing to clean the source directory or its ancestor: ${path}")
    endif()
    if(NOT path IN_LIST known)
        foreach(folder include src tests cmake scripts docs assets tools android third_party
                .git .github .vscode .agents .codex .aws)
            set(protected "${source}/${folder}")
            cmake_path(IS_PREFIX protected "${path}" NORMALIZE inside)
            if(inside)
                message(FATAL_ERROR "Refusing to clean a source directory: ${path}")
            endif()
        endforeach()
    endif()
    get_filename_component(parent "${path}" DIRECTORY)
    while(NOT parent STREQUAL "/")
        if(IS_SYMLINK "${parent}")
            message(FATAL_ERROR "Refusing to clean through a symlink: ${path}")
        endif()
        get_filename_component(next "${parent}" DIRECTORY)
        if(next STREQUAL parent)
            break()
        endif()
        set(parent "${next}")
    endwhile()
    if(IS_SYMLINK "${path}" OR NOT EXISTS "${path}")
        continue()
    endif()
    if(NOT IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Refusing to clean a regular file: ${path}")
    endif()
    if(NOT path IN_LIST known)
        set(cache "${path}/CMakeCache.txt")
        if(NOT EXISTS "${cache}" OR IS_SYMLINK "${cache}")
            message(FATAL_ERROR "Custom cleanup path is not a configured Beam build: ${path}")
        endif()
        file(STRINGS "${cache}" home REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
        file(STRINGS "${cache}" project REGEX "^CMAKE_PROJECT_NAME:STATIC=")
        if(NOT home STREQUAL "CMAKE_HOME_DIRECTORY:INTERNAL=${source}" OR
           NOT project STREQUAL "CMAKE_PROJECT_NAME:STATIC=Beam")
            message(FATAL_ERROR "Custom cleanup path belongs to another project: ${path}")
        endif()
    endif()
endforeach()
foreach(path IN LISTS roots)
    if(IS_SYMLINK "${path}")
        file(REMOVE "${path}")
    elseif(EXISTS "${path}")
        file(REMOVE_RECURSE "${path}")
    else()
        continue()
    endif()
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Could not remove build folder: ${path}")
    endif()
    message(STATUS "Removed ${path}")
endforeach()
message(STATUS "Clean complete (including project-local dependencies and toolchains)")
