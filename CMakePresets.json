{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos/dev",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "BEAM_ENABLE_DESKTOP": "ON",
        "BEAM_MACOS_BUNDLE_ID": "org.beam.desktop.dev"
      }
    },
    {
      "name": "macos-release",
      "inherits": "macos-dev",
      "binaryDir": "${sourceDir}/build/macos/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BEAM_MACOS_BUNDLE_ID": "org.beam.desktop"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-dev", "configurePreset": "macos-dev" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ]
}
