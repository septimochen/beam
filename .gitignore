# Ignore everything; explicitly allow source and project configuration.
*
!/.gitignore
!/.clang-format
!/.clang-tidy
!/AGENTS.md
!/README.md
!/CMakeLists.txt
!/Makefile
!/include/
!/include/**/
!/include/**/*.hpp
!/src/
!/src/**/
!/src/**/*.cpp
!/tests/
!/tests/**/
!/tests/**/*.cpp
!/tests/**/*.cmake
!/docs/
!/docs/**/
!/docs/**/*.md
# Keep only the reviewed app-icon concept boards; other image output stays ignored.
!/docs/design/icons/a-prism-beam.png
!/docs/design/icons/b-folded-b.png
!/docs/design/icons/c-twin-portal.png
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

!/src/**/*.hpp
!/src/**/*.h
!/src/**/*.mm
!/src/**/*.swift
!/src/**/*.plist.in
!/src/**/CMakeLists.txt
!/tests/**/*.sh
!/tests/**/*.swift
!/cmake/
!/cmake/**/*.cmake
!/cmake/**/*.cmake.in
!/android/
!/android/**/
!/android/**/*.kts
!/android/**/*.kt
!/android/**/*.java
!/android/**/*.xml
!/android/gradle.properties
!/android/gradlew
!/android/gradle/wrapper/gradle-wrapper.jar
!/android/gradle/wrapper/gradle-wrapper.properties
!/android/native/CMakeLists.txt
# Never admit generated Gradle/native output or local SDK settings.
/android/.gradle/
/android/.idea/
/android/.kotlin/
/android/**/build/
/android/**/.cxx/
