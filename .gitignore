# Ignore everything; explicitly allow source and project configuration.
*
!/.gitignore
!/.clang-format
!/.clang-tidy
!/AGENTS.md
!/README.md
!/CMakeLists.txt
!/Makefile
!/CMakePresets.json
!/.vscode/
!/.vscode/settings.json
!/scripts/
!/scripts/*.sh
!/scripts/*.jxa
!/scripts/*.awk
!/include/
!/include/**/
!/include/**/*.hpp
!/src/
!/src/**/
!/src/**/*.cpp
!/tests/
!/tests/**/
!/tests/**/*.cpp
!/tests/**/*.cmake
!/docs/
!/docs/**/
!/docs/**/*.md
!/assets/
!/assets/icons/
!/assets/icons/**/
!/assets/icons/**/*.svg
!/assets/icons/**/*.json
!/assets/icons/*.png
!/assets/icons/*.icns
!/assets/icons/*.pdf
!/assets/icons/README.md
!/tools/
!/tools/*.swift
# Keep only the reviewed app-icon concept boards; other image output stays ignored.
!/docs/design/icons/a-prism-beam.png
!/docs/design/icons/b-folded-b.png
!/docs/design/icons/c-twin-portal.png
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

!/src/**/*.hpp
!/src/**/*.h
!/src/**/*.mm
!/src/**/*.swift
!/src/**/*.plist.in
!/src/**/CMakeLists.txt
!/tests/**/*.sh
!/tests/**/*.swift
!/cmake/
!/cmake/**/
!/cmake/**/*.cmake
!/cmake/**/*.cmake.in
!/cmake/**/CMakeLists.txt
!/cmake/**/*.cpp
!/cmake/PairingMbedConfig.h
!/cmake/PairingCryptoConfig.h
!/third_party/
!/third_party/qrcodegen/
!/third_party/qrcodegen/*.cpp
!/third_party/qrcodegen/*.hpp
!/third_party/qrcodegen/*.md
!/android/
!/android/**/
!/android/**/*.kts
!/android/**/*.kt
!/android/**/*.java
!/android/**/*.xml
!/android/gradle.properties
!/android/app/proguard-rules.pro
!/android/gradlew
!/android/gradle/wrapper/gradle-wrapper.jar
!/android/gradle/wrapper/gradle-wrapper.properties
!/android/native/CMakeLists.txt
# Never admit generated Gradle/native output or local SDK settings.
/android/.gradle/
/android/.idea/
/android/.kotlin/
/android/**/build/
/android/**/.cxx/

!/third_party/licenses/
!/third_party/licenses/*.md
!/third_party/msquic/
!/third_party/msquic/include/
!/third_party/msquic/include/*.h
!/third_party/msquic/README.md
!/third_party/msquic/LICENSE
