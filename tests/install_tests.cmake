cmake_minimum_required(VERSION 3.25)
set(root "${BEAM_BUILD_DIR}/install smoke")
file(REMOVE_RECURSE "${root}")
file(REMOVE_RECURSE "${root} relocated")
set(prefix "${root}/local")
set(applications "${root}/Applications")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BEAM_BUILD_DIR}"
    --config "${BEAM_CONFIG}" --prefix "${prefix}" --component cli
    COMMAND_ERROR_IS_FATAL ANY)
if(BEAM_HAS_DESKTOP)
    if(APPLE)
        set(desktop_prefix "${applications}")
    else()
        set(desktop_prefix "${prefix}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BEAM_BUILD_DIR}"
        --config "${BEAM_CONFIG}" --prefix "${desktop_prefix}" --component desktop
        COMMAND_ERROR_IS_FATAL ANY)
    if(NOT APPLE)
        # CMake's default entry destination follows --prefix. The Make wrapper
        # separately selects the user's XDG application directory.
        file(READ "${prefix}/share/applications/beam.desktop" entry)
        string(FIND "${entry}" "Exec=\"${prefix}/bin/beam-desktop\"" position)
        if(position LESS 0)
            message(FATAL_ERROR "Desktop entry does not use the installation prefix: ${entry}")
        endif()
        find_program(desktop_validator desktop-file-validate)
        if(desktop_validator)
            execute_process(COMMAND "${desktop_validator}" "${prefix}/share/applications/beam.desktop"
                COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endif()
endif()
# Moving the complete installation proves it has no runtime dependency on its
# original prefix. Linux's system OpenSSL/Qt packages remain prerequisites.
file(RENAME "${root}" "${root} relocated")
set(root "${root} relocated")
set(prefix "${root}/local")
set(executables "${prefix}/bin/beam")
if(BEAM_HAS_DESKTOP)
    if(APPLE)
        list(APPEND executables "${root}/Applications/Beam.app/Contents/MacOS/beam-desktop")
    else()
        list(APPEND executables "${prefix}/bin/beam-desktop")
    endif()
endif()
foreach(executable IN LISTS executables)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env QT_QPA_PLATFORM=offscreen
        LD_LIBRARY_PATH= DYLD_LIBRARY_PATH= "${executable}" --version COMMAND_ERROR_IS_FATAL ANY)
    if(APPLE)
        execute_process(COMMAND /usr/bin/codesign --verify "${executable}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND /usr/bin/otool -L "${executable}" OUTPUT_VARIABLE dependencies
            COMMAND_ERROR_IS_FATAL ANY)
        string(REGEX REPLACE "^[^\n]*\n" "" dependencies "${dependencies}")
        if(dependencies MATCHES "@rpath/libmsquic|/opt/homebrew/|/usr/local/|${BEAM_BUILD_DIR}/")
            message(FATAL_ERROR "Installed executable still references external dependencies: ${dependencies}")
        endif()
    elseif(BEAM_HAS_QUIC)
        execute_process(COMMAND ldd "${executable}" OUTPUT_VARIABLE dependencies COMMAND_ERROR_IS_FATAL ANY)
        string(FIND "${dependencies}" "${prefix}/bin/../lib/beam/libmsquic" position)
        if(position LESS 0)
            message(FATAL_ERROR "Installed executable did not load private MsQuic: ${dependencies}")
        endif()
    endif()
endforeach()
if(APPLE AND BEAM_HAS_DESKTOP)
    execute_process(COMMAND /usr/bin/codesign --verify --deep "${root}/Applications/Beam.app"
        COMMAND_ERROR_IS_FATAL ANY)
endif()
file(REMOVE_RECURSE "${root}")
